    type snowflake = u64;

    @since(version = 0.1.0)
    type reaction = string;

    @since(version = 0.1.0)
    variant body {
        json(json),
        form(form),
    }

    @since(version = 0.1.0)
    record form {
        boundary: list<u8, 15>,
        buffer: list<u8>,
    }


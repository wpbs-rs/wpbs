/// Provides logging levels and host shutdown actions.
@since(version = 0.1.0)
interface types {
    /// A severity level for a log message.
    @since(version = 0.1.0)
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
    }

    /// A host shutdown action.
    @since(version = 0.1.0)
    enum shutdown-action {
        stop,
        restart,
    }
}
